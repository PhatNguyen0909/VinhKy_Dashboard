@startuml 
title HỆ THỐNG TRIỂN KHAI ỨNG DỤNG BÁN HÀNG TRỰC TUYẾN

skinparam shadowing false
skinparam linetype ortho
skinparam defaultTextAlignment left
skinparam componentStyle rectangle

' ===================== CLIENT =====================
node "Client Device\n<<device>>" as user {
  node "Web Browser\n<<executionEnvironment>>" as browser {
    artifact "React SPA (Customer UI)\n<<artifact>>" as spa {
      component "UI Components\n(Home, Cart, Order, Restaurant)" as UI
      component "StoreContext\n(State Management)" as StoreContext
      component "APIClient\n(Axios + Token)" as APIClient
      component "RestaurantService" as RestaurantService
      component "MenuService" as MenuService
      component "UserService" as UserService
      component "OrderService" as OrderService
    }
  }
}

' ===================== INTERNET =====================
cloud "Internet" as internet

' ===================== WEB LAYER / CDN =====================
node "Web Layer\n<<node>>" as webLayer {
  node "CDN / Web Server\n<<executionEnvironment>>" as cdn {
    artifact "Static Assets (JS/CSS)\n<<artifact>>" as staticAssets
  }
}

' ===================== BACKEND =====================
node "Application Server\n<<device>>" as backend {
  node "Runtime Environment\n(Spring Boot JVM)\n<<executionEnvironment>>" as jvm {
    artifact "API Server\n(Spring Boot / Java)\n<<artifact>>" as api {
      component "Auth APIs" as AuthAPIs
      component "Option APIs" as OptionAPIs
      component "Cart Controller" as CartController
      component "Order Controller" as OrderController
      component "Rating Controller" as RatingController
    }
  }
}

' ===================== DATABASE =====================
node "Database Server\n<<device>>" as dbzone {
  node "MySQL Engine\n<<executionEnvironment>>" as mysqlEngine {
    database "MySQL Database\n<<artifact>>" as mysql
  }
  frame "Tables" as tables {
    component "orders" as t_orders
    component "users" as t_users
    component "products" as t_products
    component "etc." as t_etc
  }
}

' ===================== RELATIONSHIPS =====================
UI --> StoreContext : reads / writes state
UI --> RestaurantService
UI --> MenuService
UI --> UserService
UI --> OrderService

StoreContext ..> RestaurantService : subscribe / dispatch
StoreContext ..> MenuService
StoreContext ..> UserService
StoreContext ..> OrderService

RestaurantService --> APIClient
MenuService --> APIClient
UserService --> APIClient
OrderService --> APIClient

browser --> cdn : HTTPS (load static assets)
APIClient -down-> internet : HTTPS (API calls)
internet -down-> api : HTTPS (API calls)
api --> mysql : SQL (TCP 3306)

@enduml

