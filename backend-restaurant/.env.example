# Database settings are optional for local development; without DB_HOST, SQLite is used.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Cloudinary image uploads (set the real values in Render / a local untracked .env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_SECRET=change-me
